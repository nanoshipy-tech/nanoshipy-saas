# ==============================================================================
# NANOSHIPY LOGISTICS SaaS — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and replace with production credentials.
# All 118 required and optional environment variables are documented below.
# ==============================================================================

# ==============================================================================
# 1. CORE APPLICATION & NETWORKING
# ==============================================================================
NODE_ENV=development
PORT=5000
APP_URL=https://api.nanoshipy.com
APP_BASE_URL=https://api.nanoshipy.com
FRONTEND_URL=https://app.nanoshipy.com
PLATFORM_ADMIN_FRONTEND_URL=https://admin.nanoshipy.com

# ==============================================================================
# 2. DATABASE CONFIGURATION (PostgreSQL / SQLite)
# ==============================================================================
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=nanoshipy_db
DB_USER=nanoshipy_user
DB_PASSWORD=your-secure-postgres-password
SEQUELIZE_DIALECT=postgres
# Set USE_SQLITE=true to run against local SQLite database for isolated testing
USE_SQLITE=false

# ==============================================================================
# 3. REDIS & BACKGROUND QUEUES (BullMQ)
# ==============================================================================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# Set USE_MOCK_REDIS=true only for local unit tests without a Redis instance
USE_MOCK_REDIS=false

# ==============================================================================
# 4. AUTHENTICATION & JWT SECRETS
# ==============================================================================
# Tenant Seller Authentication (min 32 characters)
JWT_ACCESS_SECRET=your-very-long-tenant-access-secret-min-32-chars
JWT_REFRESH_SECRET=your-very-long-tenant-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# Platform Admin Authentication (isolated secrets from tenant auth)
PLATFORM_JWT_ACCESS_SECRET=your-very-long-platform-access-secret-min-32-chars
PLATFORM_JWT_REFRESH_SECRET=your-very-long-platform-refresh-secret-min-32-chars
PLATFORM_JWT_ACCESS_EXPIRY=15m
PLATFORM_JWT_REFRESH_EXPIRY=7d
PLATFORM_IMPERSONATION_TOKEN_EXPIRY=30m

# Security & Sub-user Invitations
BCRYPT_SALT_ROUNDS=12
SUB_USER_INVITE_EXPIRY_HOURS=72

# ==============================================================================
# 5. ENCRYPTION KEYS (AES-256-GCM — must be exactly 32 bytes / characters)
# ==============================================================================
ENCRYPTION_KEY=your-32-character-global-key!!
TOTP_ENCRYPTION_KEY=your-32-character-totp-key!!!!
PROVIDER_CREDENTIALS_ENCRYPTION_KEY=your-32-char-provider-cred-key!!
INTEGRATION_CREDENTIALS_ENCRYPTION_KEY=your-32-char-integ-cred-key!!!

# ==============================================================================
# 6. OBJECT STORAGE (Local, AWS S3, or Cloudflare R2)
# ==============================================================================
# Options: 'local' | 's3' | 'r2'
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# AWS S3 Configuration (if STORAGE_PROVIDER=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION=ap-south-1
AWS_S3_BUCKET=nanoshipy-storage

# Cloudflare R2 Configuration (if STORAGE_PROVIDER=r2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=nanoshipy-r2

# ==============================================================================
# 7. PAYMENT GATEWAY & WALLET RECHARGES (Razorpay & RazorpayX Payouts)
# ==============================================================================
RAZORPAY_KEY_ID=rzp_test_yourKeyId
RAZORPAY_KEY_SECRET=yourRazorpayKeySecret
RAZORPAY_WEBHOOK_SECRET=yourRazorpayWebhookSecret

# COD Remittance Payouts
PAYOUT_PROVIDER=razorpayx
RAZORPAYX_KEY_ID=rzp_x_yourKeyId
RAZORPAYX_KEY_SECRET=yourRazorpayXSecret
RAZORPAYX_ACCOUNT_NUMBER=yourVirtualAccountNumber

# ==============================================================================
# 8. CARRIER INTEGRATIONS & SERVICEABILITY
# ==============================================================================
# Global Mock Toggle (MUST be false in production)
USE_MOCK_COURIER=false

# Blue Dart Carrier API
BLUEDART_SANDBOX_BASE_URL=https://apigateway-sandbox.bluedart.com
BLUEDART_LIVE_BASE_URL=https://apigateway.bluedart.com

# Delhivery Carrier API
DELHIVERY_SANDBOX_BASE_URL=https://staging-express.delhivery.com
DELHIVERY_LIVE_BASE_URL=https://track.delhivery.com

# Xpressbees Carrier API
XPRESSBEES_SANDBOX_BASE_URL=https://shipment.xpressbees.com
XPRESSBEES_LIVE_BASE_URL=https://shipment.xpressbees.com

# Ecom Express Carrier API
ECOMEXPRESS_SANDBOX_BASE_URL=https://clbeta.ecomexpress.in
ECOMEXPRESS_LIVE_BASE_URL=https://api.ecomexpress.in

# Shadowfax Carrier API
SHADOWFAX_SANDBOX_BASE_URL=https://staging.shadowfax.in
SHADOWFAX_LIVE_BASE_URL=https://api.shadowfax.in

# Shipway Fallback Tracking
SHIPWAY_BASE_URL=https://app.shipway.in/api/v2

# GrowMax Aggregator Credentials (if used)
GROWAX_API_KEY=
GROWAX_CONNECTION_KEY=

# Provider Health & Circuit Breaker Settings
PROVIDER_DEFAULT_TIMEOUT_MS=8000
PROVIDER_HEALTH_CHECK_STALE_MINUTES=10
PROVIDER_RETRY_BASE_DELAY_MS=1000
PROVIDER_RETRY_MAX_ATTEMPTS=3
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_WINDOW_SECONDS=60
CIRCUIT_BREAKER_COOLDOWN_SECONDS=300

# Rate Comparison & Quoting
SHIPMENT_RATE_QUOTE_EXPIRY_MINUTES=15
SHIPMENT_RATE_COMPARISON_TIMEOUT_MS=10000
PINCODE_EXTERNAL_FALLBACK_ENABLED=false

# ==============================================================================
# 9. COMMUNICATIONS (WhatsApp, SMS, Email SMTP)
# ==============================================================================
# WhatsApp Cloud API / Direct Meta
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=your_webhook_verification_token

# WhatsApp BSP (Interakt / Gupshup)
WHATSAPP_BSP_API_KEY=
WHATSAPP_BSP_SOURCE_NUMBER=
INTERAKT_API_KEY=
INTERAKT_WEBHOOK_SECRET=

# SMS (MSG91)
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_DLT_TEMPLATE_ID=
SMS_API_KEY=

# Email (SMTP)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your-sendgrid-or-smtp-key
SMTP_FROM=no-reply@nanoshipy.com
NOTIFICATION_DISPATCH_RETRY_ATTEMPTS=3

# ==============================================================================
# 10. STOREFRONT INTEGRATIONS (Shopify & WooCommerce)
# ==============================================================================
# Shopify Public/Custom Distribution App (Option A OAuth)
SHOPIFY_CLIENT_ID=your-shopify-app-client-id
SHOPIFY_CLIENT_SECRET=your-shopify-app-client-secret
SHOPIFY_REDIRECT_URI=https://api.nanoshipy.com/api/integrations/shopify/oauth/callback
SHOPIFY_SCOPES=read_orders,write_orders,read_fulfillments,write_fulfillments,read_merchant_managed_fulfillment_orders,write_merchant_managed_fulfillment_orders,read_assigned_fulfillment_orders,write_assigned_fulfillment_orders,read_third_party_fulfillment_orders,write_third_party_fulfillment_orders,read_shop

# Shopify Webhooks (HMAC verification fallback for Option B custom apps)
SHOPIFY_WEBHOOK_SECRET=your-shopify-webhook-secret
WOOCOMMERCE_WEBHOOK_SECRET=your-woocommerce-webhook-secret

# ==============================================================================
# 11. BILLING, GST & SUBSCRIPTION ENFORCEMENT
# ==============================================================================
GST_RATE_PERCENT=18
BILLING_ENTITY_LEGAL_NAME=Nanoshipy Technologies Private Limited
BILLING_ENTITY_GSTIN=27AAAAA0000A1Z5
BILLING_ENTITY_ADDRESS=101 Tech Park, Mumbai, Maharashtra 400001
BILLING_ENTITY_STATE=Maharashtra
INVOICE_FINANCIAL_YEAR_START_MONTH=4
MONTHLY_STATEMENT_DAY_OF_MONTH=1
SUBSCRIPTION_GRACE_PERIOD_DAYS=3
SUBSCRIPTION_RENEWAL_CHECK_HOUR=2

# ==============================================================================
# 12. OPERATIONS, NDR, DISPUTES & SLA THRESHOLDS
# ==============================================================================
NDR_SLA_HOURS=24
NDR_AUTO_RTO_THRESHOLD=3
WEIGHT_DISPUTE_WINDOW_DAYS=7
WEIGHT_DISPUTE_PER_KG_RATE=50
TICKET_SLA_URGENT_HOURS=2
TICKET_SLA_HIGH_HOURS=6
TICKET_SLA_MEDIUM_HOURS=24
TICKET_SLA_LOW_HOURS=48

# ==============================================================================
# 13. DEVELOPER API, WEBHOOKS & COMPLIANCE
# ==============================================================================
API_KEY_RATE_LIMIT_PER_MINUTE=120
DEVELOPER_API_SANDBOX_STATUS_DELAY_MS=5000
WEBHOOK_DELIVERY_TIMEOUT_MS=10000
WEBHOOK_MAX_RETRY_ATTEMPTS=5
ALLOW_DEV_WEBHOOK_BYPASS=false

# ==============================================================================
# 14. ANALYTICS, AUDITS & LOG RETENTION
# ==============================================================================
ANALYTICS_SNAPSHOT_HOUR=1
MAX_ANALYTICS_RANGE_DAYS=90
REPORT_EXPORT_URL_EXPIRY_DAYS=7
AUDIT_LOG_RETENTION_DAYS=90
FINANCIAL_AUDIT_MIN_RETENTION_DAYS=2920 # 8 Years (Indian Companies Act & GST Compliance)
ACTIVITY_LOG_EXPORT_MAX_ROWS=10000

# ==============================================================================
# 15. EXCEL EXPORTS & OUTWARD WEBHOOK DISPATCH
# ==============================================================================
# Exports synchronous vs asynchronous threshold (rows)
EXPORT_SYNC_ROW_LIMIT=5000
# Hard limit on total exportable rows per request
EXPORT_MAX_ROWS=50000
# Maximum concurrent active export jobs per tenant
EXPORT_MAX_CONCURRENT_PER_TENANT=3
# Time-to-live for export files in hours before automatic purge
EXPORT_FILE_TTL_HOURS=24
# Keyset batch pagination size for memory-flat Excel streaming
EXPORT_BATCH_SIZE=1000

# Outward Webhook Dispatching & Security
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_DISABLE_AFTER_FAILURES=10

